<Window x:Class="LanScope.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LANscope · Packet workspace" Width="1440" Height="960" MinWidth="1120" MinHeight="780" Background="#F3F6FA" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#142238"><Grid Margin="22,30"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="◈  LANscope" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="PACKET WORKSPACE" Foreground="#94A8C5" FontSize="10" Margin="0,8,0,0"/></StackPanel>
<StackPanel Grid.Row="1"><TextBlock Text="WORKSPACE" Foreground="#7890B1" FontSize="10" Margin="0,20,0,18"/><Border Background="#263D60" Padding="14" CornerRadius="6"><TextBlock Text="▤   패킷 분석" Foreground="White" FontWeight="SemiBold"/></Border><TextBlock Text="로컬 파일 · 오프라인 분석" Foreground="#A6B7D0" Margin="14,22,0,0"/><TextBlock Text="실시간 수집 · 준비 중" Foreground="#7890B1" Margin="14,22,0,0"/></StackPanel>
<StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="UI PREVIEW  /  v0.1" Foreground="#8CA2C1" FontSize="11"/><TextBlock Text="Windows · WPF" Foreground="#627C9F" Margin="0,8,0,0"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1" Margin="28,26,28,18"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="55"/><RowDefinition Height="100"/><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="230"/><RowDefinition Height="28"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="WORKSPACE  /  PACKET ANALYSIS" Foreground="#8492A6" FontSize="10"/><TextBlock Text="패킷 분석" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="●  데모 데이터" Foreground="#B7791F" FontWeight="SemiBold"/><TextBlock Text="실제 네트워크를 수집하지 않습니다" Foreground="#8492A6" FontSize="11" Margin="0,6,0,0"/></StackPanel></Grid>
<Border Grid.Row="1" Background="#EAF1FD" CornerRadius="6" Padding="16,12" Margin="0,0,0,12"><TextBlock Text="디자인 검토용 미리보기입니다. 샘플 패킷 선택·검색·PCAP 저장을 사용할 수 있습니다. 실제 수집은 후속 구현 대상입니다." Foreground="#41618F" VerticalAlignment="Center"/></Border>
<Grid Grid.Row="2" Margin="0,4,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="7" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="전체 패킷" Foreground="#8492A6"/><TextBlock Text="8" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Background="White" CornerRadius="7" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="데이터 크기" Foreground="#8492A6"/><TextBlock Text="6.24 KB" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Background="White" CornerRadius="7" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="프로토콜" Foreground="#8492A6"/><TextBlock Text="4" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
<Border Grid.Column="3" Background="White" CornerRadius="7" Padding="18"><StackPanel><TextBlock Text="분석 세션" Foreground="#8492A6"/><TextBlock Text="샘플 세션" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border></Grid>
<Grid Grid.Row="3" Margin="0,2,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="↻  샘플 다시 불러오기" Click="ResetClick"/><Button Grid.Column="1" Content="↓  샘플 PCAP 저장" Click="SaveClick" Background="#2563EB" Foreground="White" BorderThickness="0"/><TextBox Grid.Column="2" x:Name="SearchBox" TextChanged="SearchChanged" Padding="14,10" VerticalContentAlignment="Center" Margin="20,0,0,0" ToolTip="프로토콜, IP, 내용으로 검색"/></Grid>
<Border Grid.Row="4" Background="White" CornerRadius="7" BorderBrush="#E1E7EF" BorderThickness="1" Padding="0,10,0,0"><DockPanel><Grid DockPanel.Dock="Top" Margin="16,4,16,14"><TextBlock Text="패킷 목록" FontWeight="SemiBold"/><TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="#8492A6" Text="8 packets"/></Grid><DataGrid x:Name="PacketGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" BorderThickness="0" RowHeight="35" ColumnHeaderHeight="34" Background="White" SelectionMode="Single" SelectionChanged="SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="No." Binding="{Binding Number}" Width="48"/><DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="출발지" Binding="{Binding Source}" Width="145"/><DataGridTextColumn Header="목적지" Binding="{Binding Destination}" Width="145"/><DataGridTextColumn Header="프로토콜" Binding="{Binding Protocol}" Width="85"/><DataGridTextColumn Header="길이" Binding="{Binding Length}" Width="60"/><DataGridTextColumn Header="정보" Binding="{Binding Info}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Grid Grid.Row="5" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="7" Padding="18" Margin="0,0,14,0"><StackPanel><TextBlock Text="패킷 상세" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="DetailText" Margin="0,16,0,0" LineHeight="25" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="#17253B" CornerRadius="7" Padding="18"><StackPanel><TextBlock Text="RAW BYTES  /  HEX + ASCII" Foreground="#9DB2D2" FontSize="11"/><TextBlock x:Name="HexText" FontFamily="Consolas" Foreground="#B5D4F9" FontSize="12" LineHeight="24" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock Text="별도 합성 UDP 예시 · 46 bytes · 목록과 무관" Foreground="#7691B7" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border></Grid>
<TextBlock Grid.Row="6" x:Name="StatusText" Text="준비됨   ·   샘플 데이터 8개   ·   실제 LAN 수집 비활성" FontSize="11" Foreground="#8492A6" VerticalAlignment="Bottom"/>
</Grid></Grid></Window>
