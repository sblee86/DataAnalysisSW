<Window x:Class="LanScope.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LANscope · Recording workspace" Width="1440" Height="960" MinWidth="1150" MinHeight="800" Background="#F3F6FA" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Closing="WindowClosing">
<Window.Resources>
<Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="#D9E1EC"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/></Style>
<Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/></Style>
</Window.Resources>
<Grid>
<Grid x:Name="LoginView"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Border Background="#142238"><StackPanel VerticalAlignment="Center" Margin="70"><TextBlock Text="◈  LANscope" Foreground="White" FontWeight="Bold" FontSize="38"/><TextBlock Text="RECORD. INSPECT. UNDERSTAND." Foreground="#90A9CD" FontSize="11" Margin="0,20,0,50"/><TextBlock Text="시험 기록의 시작부터,&#10;패킷 하나까지." Foreground="White" FontSize="30" LineHeight="45"/><TextBlock Text="ICD 프로파일과 NIC을 연결하고&#10;시험별 패킷 기록을 관리하세요." Foreground="#A7B9D2" FontSize="15" Margin="0,24,0,0" LineHeight="27"/></StackPanel></Border>
<Border Grid.Column="1" Width="390" VerticalAlignment="Center"><StackPanel><TextBlock Text="SECURE WORKSPACE" Foreground="#8492A6" FontSize="11"/><TextBlock Text="로그인" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,12"/><TextBlock Text="계정 권한에 맞는 작업 공간으로 연결합니다." Foreground="#8492A6" Margin="0,0,0,36"/><TextBlock Text="사용자 ID" Margin="0,0,0,9"/><TextBox x:Name="UserIdBox" AutomationProperties.Name="사용자 ID"/><TextBlock Text="암호" Margin="0,24,0,9"/><PasswordBox x:Name="PasswordInput" Padding="12,11" BorderBrush="#D9E1EC" AutomationProperties.Name="암호" KeyDown="PasswordKeyDown"/><TextBlock x:Name="LoginError" Foreground="#C24141" Margin="0,14,0,14" TextWrapping="Wrap" MinHeight="36"/><Button x:Name="LoginButton" Content="작업 공간으로 로그인  →" Click="LoginClick" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="16,14" Margin="0"/><TextBlock Text="계정 정보는 내장 바이너리 리소스로 관리됩니다." Foreground="#8492A6" FontSize="11" Margin="0,24,0,0"/></StackPanel></Border></Grid>
<Grid x:Name="WorkspaceView" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#142238"><Grid Margin="20,30"><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions><StackPanel><TextBlock Text="◈  LANscope" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="RECORDING WORKSPACE" Foreground="#94A8C5" FontSize="10" Margin="0,9,0,0"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="WORKSPACE" Foreground="#7890B1" FontSize="10" Margin="10,8,0,18"/><Button Content="▤  기록 대시보드" Click="DashboardClick" Background="#263D60" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Margin="0,0,0,12"/><Button x:Name="ProfileNav" Content="◇  기록 프로파일" Click="ProfilesClick" Background="#142238" Foreground="#B7C8DF" BorderThickness="0" HorizontalContentAlignment="Left" Margin="0,0,0,12"/><Button x:Name="SettingsNav" Content="⚙  기록 설정" Click="SettingsClick" Background="#142238" Foreground="#B7C8DF" BorderThickness="0" HorizontalContentAlignment="Left" Margin="0"/><TextBlock x:Name="PermissionNote" Foreground="#8CA2C1" TextWrapping="Wrap" Margin="10,28,8,0" LineHeight="22"/></StackPanel><StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock x:Name="AccountText" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,8"/><Button Content="로그아웃" Click="LogoutClick" Background="#263D60" Foreground="#B7C8DF" BorderThickness="0" Margin="0"/><TextBlock Text="Windows · WPF / v0.4" Foreground="#7890B1" FontSize="10" Margin="8,18,0,0"/></StackPanel></Grid></Border>
<Grid Grid.Column="1" Margin="28,26,28,18"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="55"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="WORKSPACE / RECORDING" Foreground="#8492A6" FontSize="10"/><TextBlock x:Name="PageTitle" Text="기록 대시보드" FontSize="28" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel><TextBlock x:Name="RunBadge" Text="● 대기 중" Foreground="#60728E" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid>
<Grid Grid.Row="1">
<Grid x:Name="DashboardView"><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="150"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="7" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="NIC → 프로파일" Foreground="#8492A6"/><TextBlock x:Name="MappingTotal" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="7" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="매칭 패킷 합계" Foreground="#8492A6"/><TextBlock x:Name="PacketTotal" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="White" CornerRadius="7" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="기록 데이터" Foreground="#8492A6"/><TextBlock x:Name="ByteTotal" Text="0 B" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="3" Background="White" CornerRadius="7" Padding="18"><StackPanel><TextBlock Text="시험 경과" Foreground="#8492A6"/><TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></Grid>
<Border Grid.Row="1" Background="White" CornerRadius="7" Padding="18" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="시험 기록" FontWeight="SemiBold" FontSize="15"/><TextBox x:Name="TestNameBox" Grid.Row="1" Text="Test-001" Margin="0,6,14,4" ToolTip="시험 이름 · 기록 시작 시 새 폴더 생성"/><Button x:Name="StartButton" Grid.Row="1" Grid.Column="1" Content="●  기록 시작" Click="StartClick" Background="#2563EB" Foreground="White" BorderThickness="0"/><Button x:Name="StopButton" Grid.Row="1" Grid.Column="2" Content="■  중지" Click="StopClick" IsEnabled="False"/><TextBlock x:Name="OutputText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="#8492A6" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/></Grid></Border>
<Border Grid.Row="2" Background="White" CornerRadius="7" Padding="0,14,0,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="18,0,18,14"><TextBlock Text="NIC → 프로파일별 수집 현황" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="복수 프로파일에 매칭된 패킷은 각각 기록됩니다. 용량은 패킷 바이트 기준이며 PCAP 헤더는 제외합니다." Foreground="#8492A6" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><DataGrid x:Name="MonitorGrid"><DataGrid.Columns><DataGridTextColumn Header="NIC" Binding="{Binding Nic}" Width="140"/><DataGridTextColumn Header="프로파일" Binding="{Binding Profile}" Width="150"/><DataGridTextColumn Header="패킷" Binding="{Binding Packets}" Width="75"/><DataGridTextColumn Header="용량 (B)" Binding="{Binding Bytes}" Width="90"/><DataGridTextColumn Header="최소" Binding="{Binding MinSize}" Width="60"/><DataGridTextColumn Header="최대" Binding="{Binding MaxSize}" Width="60"/><DataGridTextColumn Header="평균 (B)" Binding="{Binding AverageSize, StringFormat=F1}" Width="80"/><DataGridTextColumn Header="최근 수신" Binding="{Binding LastPacket}" Width="105"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Row="3" Background="#EAF1FD" CornerRadius="7" Padding="18" Margin="0,16,0,0"><TextBlock x:Name="SessionText" Text="관리자가 ICD 프로파일과 NIC 매칭을 저장하면 기록을 시작할 수 있습니다." TextWrapping="Wrap" Foreground="#41618F" LineHeight="23"/></Border></Grid>
<Grid x:Name="ProfilesView" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="7" Padding="16" Margin="0,0,16,0"><DockPanel><Button DockPanel.Dock="Bottom" Content="+ 새 프로파일" Click="NewProfileClick" Margin="0,16,0,0"/><TextBlock DockPanel.Dock="Top" Text="기록 프로파일" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/><ListBox x:Name="ProfilesList" SelectionChanged="ProfileSelected" BorderThickness="0" DisplayMemberPath="Name"/></DockPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="7" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="CSV ICD / ENDPOINT PROFILE" FontSize="11" Foreground="#8492A6"/><TextBlock Text="프로파일 설정" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,24"/><TextBlock Text="프로파일 이름" Margin="0,0,0,8"/><TextBox x:Name="ProfileNameBox"/><TextBlock Text="ICD CSV 파일" Margin="0,22,0,8"/><WrapPanel><Button Content="CSV 선택" Click="ChooseIcdClick"/><ComboBox x:Name="SampleBox" Width="190"/><Button Content="샘플 적용" Click="UseSampleClick" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="IcdText" Text="선택된 CSV 없음" Foreground="#8492A6" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="통신은 빅엔디언 고정 · 1바이트는 그대로 읽습니다. 실제 IDLStudio CSV 샘플 확인 전 임시 열 규격을 사용합니다. 비트 위치 기본값: msb0." Foreground="#8492A6" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock Text="CSV 필드 구조" FontWeight="SemiBold" Margin="0,22,0,10"/><DataGrid x:Name="IcdFields" Height="200"><DataGrid.Columns><DataGridTextColumn Header="메시지" Binding="{Binding Message}" Width="105"/><DataGridTextColumn Header="필드" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="byte:bit" Binding="{Binding Location}" Width="65"/><DataGridTextColumn Header="bits" Binding="{Binding BitLength}" Width="45"/><DataGridTextColumn Header="type" Binding="{Binding Type}" Width="70"/><DataGridTextColumn Header="bit order" Binding="{Binding BitOrder}" Width="70"/><DataGridTextColumn Header="scale" Binding="{Binding Scale}" Width="60"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="Payload HEX 해석 미리보기 · UDP/TCP 헤더를 제외한 데이터 기준 byte_offset=0" Foreground="#8492A6" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,10"/><WrapPanel><ComboBox x:Name="MessageBoxSelect" Width="180"/><Button Content="HEX 해석" Click="DecodePayloadClick" Margin="8,0,0,0"/></WrapPanel><TextBox x:Name="PayloadHexBox" Text="00 01 B2 FF 9C 41 48 00 00" FontFamily="Consolas" Margin="0,10,0,10"/><DataGrid x:Name="DecodeGrid" Height="170"><DataGrid.Columns><DataGridTextColumn Header="필드" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="raw" Binding="{Binding Raw}" Width="90"/><DataGridTextColumn Header="해석값" Binding="{Binding Value}" Width="90"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="55"/><DataGridTextColumn Header="오류" Binding="{Binding Error}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="송신 IP · 쉼표 또는 줄바꿈으로 여러 개 입력" Margin="0,22,0,8"/><TextBox x:Name="SenderBox" AcceptsReturn="True" MinHeight="65" TextWrapping="Wrap"/><TextBlock Text="수신 IP · 쉼표 또는 줄바꿈으로 여러 개 입력" Margin="0,22,0,8"/><TextBox x:Name="ReceiverBox" AcceptsReturn="True" MinHeight="65" TextWrapping="Wrap"/><CheckBox x:Name="BothDirectionsBox" Content="역방향 응답도 기록 (송신 ↔ 수신)" IsChecked="True" Margin="0,20,0,24"/><CheckBox x:Name="GuestIcdAllowedBox" Content="이 ICD를 guest에게 기록·조회 허용 (동일 ICD의 모든 프로파일에 적용)" Margin="0,0,0,24"/><TextBlock Text="ICD 원본은 관리자 키로 AES-GCM 암호화합니다. guest는 표시 이름·수집 현황만 봅니다." Foreground="#8492A6" TextWrapping="Wrap" Margin="0,0,0,18"/><WrapPanel><Button Content="프로파일 저장" Click="SaveProfileClick" Background="#2563EB" Foreground="White" BorderThickness="0"/><Button Content="프로파일 삭제" Click="DeleteProfileClick"/></WrapPanel></StackPanel></ScrollViewer></Border></Grid>
<Grid x:Name="SettingsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions><Border Background="White" CornerRadius="7" Padding="18" Margin="0,0,0,16"><DockPanel><Button DockPanel.Dock="Right" Content="NIC 다시 검색" Click="RescanClick" Margin="16,0,0,0"/><StackPanel><TextBlock Text="기록 설정 · NIC과 프로파일 연결" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="OS에서 검색된 모든 NIC을 표시합니다. 기록할 NIC마다 프로파일을 1개 이상 선택해 매칭을 저장하세요." Foreground="#8492A6" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="7" Padding="12" Margin="0,0,16,0"><DataGrid x:Name="NicGrid" SelectionMode="Single" SelectionChanged="NicSelected"><DataGrid.Columns><DataGridTextColumn Header="NIC" Binding="{Binding Name}" Width="130"/><DataGridTextColumn Header="IP 주소" Binding="{Binding Addresses}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="140"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="1" Background="White" CornerRadius="7" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button Content="선택 NIC 매칭 저장" Click="SaveBindingClick" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/><Button Content="선택 NIC 매칭 해제" Click="RemoveBindingClick" Margin="0"/></StackPanel><TextBlock DockPanel.Dock="Top" x:Name="BindingTitle" Text="NIC을 선택하세요" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/><TextBlock DockPanel.Dock="Top" Text="Ctrl/Shift로 여러 프로파일 선택" Foreground="#8492A6" FontSize="11" Margin="0,0,0,12"/><ListBox x:Name="BindingProfiles" SelectionMode="Multiple" DisplayMemberPath="Name" BorderThickness="0"/></DockPanel></Border></Grid><Border Grid.Row="2" Background="White" CornerRadius="7" Padding="18" Margin="0,16,0,0"><StackPanel><TextBlock Text="기록 폴더 · 시험 시작 시 별도 하위 폴더 생성" FontWeight="SemiBold"/><DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="찾아보기" Click="ChooseFolderClick" Margin="12,0,0,0"/><Button DockPanel.Dock="Right" Content="경로 저장" Click="SaveFolderClick" Margin="12,0,0,0"/><TextBox x:Name="FolderBox"/></DockPanel><Button Content="이전 시험 메타데이터의 ICD 암호화" Click="ProtectLegacyClick" Margin="0,12,0,0" HorizontalAlignment="Left"/></StackPanel></Border></Grid>
</Grid><TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#60728E" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
</Grid></Grid></Grid></Window>
