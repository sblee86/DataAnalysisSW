mn Header="필드" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="raw" Binding="{Binding Raw}" Width="90"/><DataGridTextColumn Header="해석값" Binding="{Binding Value}" Width="90"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="55"/><DataGridTextColumn Header="오류" Binding="{Binding Error}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="비트 필드 값 쓰기 · 지정 범위 외의 비트는 유지" FontWeight="SemiBold" Margin="0,18,0,10"/><WrapPanel><ComboBox x:Name="WriteFieldBox" DisplayMemberPath="Name" Width="180"/><TextBox x:Name="WriteValueBox" Text="0" Width="120" Margin="8,0,8,0"/><Button Content="필드값 쓰기" Click="WriteFieldClick"/></WrapPanel><CheckBox x:Name="WriteRawBox" Margin="0,10,0,0"><TextBlock Text="raw 값으로 쓰기 (기본은 scale/bias를 역변환한 실제값)" TextWrapping="Wrap"/></CheckBox><TextBlock Text="HEX 구성/검증 기능이며 실제 네트워크로 송신하지 않습니다." Foreground="#65748B" FontSize="{DynamicResource UiFont11}" Margin="0,8,0,0"/><TextBlock Text="송신 IP · 쉼표 또는 줄바꿈으로 여러 개 입력" Margin="0,22,0,8"/><TextBox x:Name="SenderBox" AcceptsReturn="True" MinHeight="65" TextWrapping="Wrap"/><TextBlock Text="수신 IP · 쉼표 또는 줄바꿈으로 여러 개 입력" Margin="0,22,0,8"/><TextBox x:Name="ReceiverBox" AcceptsReturn="True" MinHeight="65" TextWrapping="Wrap"/><CheckBox x:Name="BothDirectionsBox" Content="역방향 응답도 기록 (송신 ↔ 수신)" IsChecked="True" Margin="0,20,0,24"/><CheckBox x:Name="GuestIcdAllowedBox" Content="이 ICD의 PCAP → CSV 값 변환을 guest에게 허용" Margin="0,0,0,24"/><TextBlock Text="ICD 원본은 관리자 키로 AES-GCM 암호화합니다. PCAP 기록은 모두 가능하며, guest의 CSV 변환만 ICD별로 제한합니다." Foreground="#65748B" TextWrapping="Wrap" Margin="0,0,0,18"/><WrapPanel><Button Content="프로파일 저장" Click="SaveProfileClick" Background="#2563EB" Foreground="White" BorderThickness="0"/><Button Content="프로파일 삭제" Click="DeleteProfileClick"/></WrapPanel></StackPanel></ScrollViewer></Border></Grid>
