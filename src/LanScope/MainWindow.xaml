ground="White" CornerRadius="7" Padding="16" Margin="0,0,16,0"><DockPanel><Button DockPanel.Dock="Bottom" Content="저장 ICD 다시 읽기" Click="ReloadIcdClick" ToolTip="디스크의 암호화된 ICD 목록을 다시 읽습니다. 저장하지 않은 편집 내용은 다시 입력해야 합니다."/><Button DockPanel.Dock="Bottom" Content="+ 새 프로파일" Click="NewProfileClick" Margin="0,16,0,0" ToolTip="현재 편집기를 비우고 새 ICD 프로파일을 만듭니다. 기존 저장 프로파일은 유지합니다."/><TextBlock DockPanel.Dock="Top" Text="기록 프로파일" FontSize="{DynamicResource UiFont15}" FontWeight="SemiBold" Margin="0,0,0,16"/><ListBox x:Name="ProfilesList" SelectionChanged="ProfileSelected" PreviewMouseRightButtonDown="ProfileRightClick" KeyDown="ProfileKeyDown" BorderThickness="0" DisplayMemberPath="CatalogLabel"><ListBox.ContextMenu><ContextMenu FontSize="{DynamicResource UiFont13}" Opened="EditContextOpened"><MenuItem Header="프로파일 삭제" Click="DeleteProfileClick" InputGestureText="Delete"/></ContextMenu></ListBox.ContextMenu></ListBox></DockPanel></Border><GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D9E1EC" DragCompleted="PaneResized"/><Border Grid.Column="2" Background="White" CornerRadius="7" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="CSV ICD / ENDPOINT PROFILE" FontSize="{DynamicResource UiFont11}" Foreground="#65748B"/><TextBlock Text="프로파일 설정" FontSize="{DynamicResource UiFont23}" FontWeight="SemiBold" Margin="0,10,0,24"/><TextBlock Text="프로파일 이름" Margin="0,0,0,8"/><TextBox x:Name="ProfileNameBox"/><TabControl Margin="0,18,0,12" BorderBrush="#E1E7EF" Background="White" x:Name="IcdTabs"><TabItem Header="현재 ICD" ToolTip="저장된 ICD의 필드와 통신 IP, 권한을 확인하고 수정합니다."><StackPanel Margin="18"><CheckBox x:Name="IcdEnabledBox" Content="활성 ICD" IsChecked="True" Margin="0,4,0,16"/><StackPanel Margin="0,8,0,18"><TextBlock Text="CSV 필드 구조" FontWeight="SemiBold" Margin="0,22,0,10"/><DataGrid x:Name="IcdFields" Height="200"><DataGrid.Columns><DataGridTextColumn Header="메시지" Binding="{Binding Message}" Width="105"/><DataGridTextColumn Header="필드" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="byte:bit / unit" Binding="{Binding Location}" Width="100"/><DataGridTextColumn Header="bits" Binding="{Binding BitLength}" Width="45"/><DataGridTextColumn Header="type" Binding="{Binding Type}" Width="70"/><DataGridTextColumn Header="bit order" Binding="{Binding BitOrder}" Width="70"/><DataGridTextColumn Header="scale" Binding="{Binding Scale}" Width="60"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel><StackPanel Margin="0,8,0,18"><TextBlock Text="송신 IP · 쉼표 또는 줄바꿈으로 여러 개 입력" Margin="0,22,0,8"/><TextBox x:Name="SenderBox" AcceptsReturn="True" MinHeight="65" TextWrapping="Wrap"/><TextBlock Text="수신 IP · 쉼표 또는 줄바꿈으로 여러 개 입력" Margin="0,22,0,8"/><TextBox x:Name="ReceiverBox" AcceptsReturn="True" MinHeight="65" TextWrapping="Wrap"/><CheckBox x:Name="BothDirectionsBox" Content="역방향 응답도 기록 (송신 ↔ 수신)" IsChecked="True" Margin="0,20,0,24"/><CheckBox x:Name="GuestIcdAllowedBox" Content="이 ICD의 PCAP → CSV 값 변환을 guest에게 허용" Margin="0,0,0,24"/><TextBlock Text="ICD 원본은 관리자 키로 AES-GCM 암호화합니다. PCAP 기록은 모두 가능하며, guest의 CSV 변환만 ICD별로 제한합니다." Foreground="#65748B" TextWrapping="Wrap" Margin="0,0,0,18"/></StackPanel></StackPanel></TabItem><TabItem Header="가져오기" ToolTip="CSV와 필요한 C/C++ 헤더를 선택한 뒤 바이트 순서와 패킹을 설정합니다."><StackPanel Margin="18"><StackPanel Margin="0"><TextBlock Text="1. CSV를 선택하고, struct를 참조하면 헤더를 함께 추가하세요.&#10;2. 해석 옵션을 확인한 뒤 현재 ICD 탭에서 검토·저장하세요." TextWrapping="Wrap" Foreground="#65748B" Margin="0,0,0,18"/><Border BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16"><StackPanel Margin="16"><TextBlock Text="파일 선택" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="ICD CSV 파일" Margin="0,22,0,8"/><WrapPanel><Button Content="CSV 선택" Click="ChooseIcdClick" ToolTip="IDLStudio CSV 또는 내보낸 icd-edit.csv를 선택합니다. 파일은 가져온 뒤 저장할 때 내부 암호화됩니다."/></WrapPanel><WrapPanel><Button Content="헤더 .h/.hpp 선택" Click="ChooseStructClick" ToolTip="CSV에서 참조한 C/C++ struct 헤더를 모두 선택합니다. include를 자동 실행하지 않습니다."/><Button Content="헤더 해제" Click="ClearStructClick" ToolTip="현재 편집 중인 외부 헤더 선택을 해제합니다. 원본 파일은 삭제하지 않습니다."/></WrapPanel><TextBlock x:Name="IcdText" Text="선택된 CSV 없음" Foreground="#65748B" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="Big/Little 또는 CSV 필드별 순서를 선택합니다. 1바이트는 동일합니다. struct는 명시적 pack·비트 순서로 배치합니다. 헤더와 CSV 원본을 함께 암호화 저장합니다." Foreground="#65748B" FontSize="{DynamicResource UiFont11}" TextWrapping="Wrap" Margin="0,9,0,0"/><Expander Header="예제 ICD로 시작하기" Margin="0,14,0,0"><WrapPanel Margin="22,12,0,0"><ComboBox x:Name="SampleBox" Width="190"/><Button Content="샘플 적용" Click="UseSampleClick" Margin="8,0,0,0" ToolTip="선택한 공개 예제 CSV를 현재 편집기에 적용합니다. 실제 IDLStudio 파일 형식 확인용 예제입니다."/></WrapPanel></Expander></StackPanel></Border><Border BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16"><StackPanel Margin="16"><TextBlock Text="해석 옵션" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel Margin="0,14,0,0"><TextBlock Text="바이트 순서 " VerticalAlignment="Center"/><ComboBox x:Name="ByteOrderBox" SelectedIndex="0" Width="155" SelectionChanged="IcdOptionChanged"><ComboBoxItem Content="CSV 필드별 설정"/><ComboBoxItem Content="Big endian"/><ComboBoxItem Content="Little endian"/></ComboBox></WrapPanel><WrapPanel Margin="0,12,0,0"><TextBlock Text="Pack " VerticalAlignment="Center"/><ComboBox x:Name="StructPackBox" Width="55" SelectedIndex="0" SelectionChanged="IcdOptionChanged"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/><ComboBoxItem Content="8"/></ComboBox><ComboBox x:Name="StructBitBox" Width="95" SelectedIndex="0" SelectionChanged="IcdOptionChanged"><ComboBoxItem Content="lsb0"/><ComboBoxItem Content="msb0"/></ComboBox></WrapPanel></StackPanel></Border></StackPanel></StackPanel></TabItem><TabItem Header="내보내기" ToolTip="현재 ICD를 CSV, 일반 C++ 구조체 또는 원본이 포함된 ZIP으로 저장합니다."><StackPanel Margin="18"><StackPanel Margin="0,8,0,18"><TextBlock Text="원하는 형식을 선택하고 저장하세요. 현재 편집 중인 ICD를 내보냅니다." TextWrapping="Wrap" Foreground="#65748B" Margin="0,0,0,12"/><WrapPanel><ComboBox x:Name="ExportFormatBox" SelectedIndex="1" Width="260"><ComboBoxItem Content="CSV · Excel 수정 후 다시 가져오기"/><ComboBoxItem Content="C++ · 필드가 선언된 struct (.hpp)"/><ComboBoxItem Content="ZIP · CSV / 구조체 / 원본 헤더"/></ComboBox><Button Content="선택 형식으로 내보내기" Click="ExportIcdClick" Margin="10,0,0,0" ToolTip="선택 형식으로 현재 ICD를 내보냅니다. CSV는 Excel 편집용, C++는 일반 struct 선언, ZIP은 원본과 옵션을 포함합니다."/></WrapPanel><Border Background="#F7F9FC" CornerRadius="5" Padding="14" Margin="0,14,0,0"><StackPanel><TextBlock Text="출력 형식 예시" Foreground="#65748B" Margin="0,0,0,10"/><TextBlock Text="struct Telemetry {&#10;    uint16_t sequence;&#10;    uint8_t mode : 3;&#10;    float voltage;&#10;};" FontFamily="Consolas"/><TextBlock Text="C++는 실제 타입·필드·배열·비트 필드 선언을 저장합니다. 네이티브 메모리 배치는 컴파일러에 따라 달라지며, 정확한 통신 위치와 배율은 CSV에 유지합니다." Foreground="#65748B" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><TextBlock Text="관리자 전용 · 내보낸 파일은 평문이며 내부 저장소는 암호화를 유지합니다." Foreground="#65748B" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></StackPanel></TabItem><TabItem Header="HEX 시험" ToolTip="실제 수집 파일을 바꾸지 않고 payload HEX를 해석하거나 필드값을 씁니다."><StackPanel Margin="18"><StackPanel Margin="0,8,0,18"><TextBlock Text="Payload HEX 해석 미리보기 · UDP/TCP 헤더를 제외한 데이터 기준 byte_offset=0" Foreground="#65748B" FontSize="{DynamicResource UiFont11}" TextWrapping="Wrap" Margin="0,18,0,10"/><WrapPanel><ComboBox x:Name="MessageBoxSelect" SelectionChanged="WriteMessageSelected" Width="180"/><Button Content="HEX 해석" Click="DecodePayloadClick" Margin="8,0,0,0" ToolTip="선택 메시지 규칙으로 입력 HEX를 해석합니다. UDP 헤더를 제외한 payload를 입력하세요."/></WrapPanel><TextBox x:Name="PayloadHexBox" Text="00 01 B2 FF 9C 41 48 00 00" FontFamily="Consolas" Margin="0,10,0,10"/><DataGrid x:Name="DecodeGrid" Height="170"><DataGrid.Columns><DataGridTextColumn Header="필드" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="raw" Binding="{Binding Raw}" Width="90"/><DataGridTextColumn Header="해석값" Binding="{Binding Value}" Width="90"/><DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="55"/><DataGridTextColumn Header="오류" Binding="{Binding Error}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="비트 필드 값 쓰기 · 지정 범위 외의 비트는 유지" FontWeight="SemiBold" Margin="0,18,0,10"/><WrapPanel><ComboBox x:Name="WriteFieldBox" DisplayMemberPath="Name" Width="180"/><TextBox x:Name="WriteValueBox" Text="0" Width="120" Margin="8,0,8,0"/><Button Content="필드값 쓰기" Click="WriteFieldClick" ToolTip="선택 필드의 값만 HEX에 반영하고 나머지 비트는 유지합니다. 네트워크로 송신하지 않습니다."/></WrapPanel><CheckBox x:Name="WriteRawBox" Margin="0,10,0,0"><TextBlock Text="raw 값으로 쓰기 (기본은 scale/bias를 역변환한 실제값)" TextWrapping="Wrap"/></CheckBox><TextBlock Text="HEX 구성/검증 기능이며 실제 네트워크로 송신하지 않습니다." Foreground="#65748B" FontSize="{DynamicResource UiFont11}" Margin="0,8,0,0"/></StackPanel></StackPanel></TabItem></TabControl><Border BorderBrush="#E1E7EF" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,10,0,0"><WrapPanel><Button Content="프로파일 저장" Click="SaveProfileClick" Background="#2563EB" Foreground="White" BorderThickness="0" ToolTip="ICD와 헤더를 암호화하고 송수신 IP·활성 상태·guest CSV 변환 권한을 저장합니다."/><Button Content="프로파일 삭제" Click="DeleteProfileClick" ToolTip="선택 프로파일과 해당 NIC 매칭을 확인 후 삭제합니다. 이미 기록된 PCAP 파일은 유지합니다."/></WrapPanel></Border></StackPanel></ScrollViewer></Border></Grid>
<Grid x:Name="SettingsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="{DynamicResource UiRow110}"/><RowDefinition Height="*"/><RowDefinition Height="{DynamicResource UiRow180}"/></Grid.RowDefinitions><Border Background="White" CornerRadius="7" Padding="18" Margin="0,0,0,16"><DockPanel><Button DockPanel.Dock="Right" Content="NIC 다시 검색" Click="RescanClick" Margin="16,0,0,0" ToolTip="운영체제에서 NIC 목록과 IP·상태를 다시 검색합니다. 기존 저장 매칭은 유지합니다."/><StackPanel><TextBlock Text="기록 설정 · NIC과 프로파일 연결" FontSize="{DynamicResource UiFont18}" FontWeight="SemiBold"/><TextBlock Text="OS에서 검색된 모든 NIC을 표시합니다. 기록할 NIC마다 프로파일을 1개 이상 선택해 매칭을 저장하세요." Foreground="#65748B" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NicLeftColumn" Width="60*" MinWidth="220"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="NicRightColumn" Width="40*" MinWidth="200"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="7" Padding="12" Margin="0,0,16,0"><DataGrid x:Name="NicGrid" PreviewMouseRightButtonDown="GridRightClick" SelectionMode="Single" SelectionChanged="NicSelected"><DataGrid.ContextMenu><ContextMenu FontSize="{DynamicResource UiFont13}" Opened="EditContextOpened"><MenuItem Header="선택 NIC 매칭 해제" Click="RemoveBindingConfirmClick"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="NIC" Binding="{Binding Name}" Width="130"/><DataGridTextColumn Header="IP 주소" Binding="{Binding Addresses}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="140"/></DataGrid.Columns></DataGrid></Border><GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D9E1EC" DragCompleted="PaneResized"/><Border Grid.Column="2" Background="White" CornerRadius="7" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button Content="선택 NIC 매칭 저장" Click="SaveBindingClick" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,0,10" ToolTip="선택 NIC에 선택한 프로파일들을 연결합니다. 기록할 NIC에는 프로파일이 한 개 이상 필요합니다."/><Button Content="선택 NIC 매칭 해제" Click="RemoveBindingClick" Margin="0" ToolTip="선택 NIC의 프로파일 연결을 해제합니다. 이미 수집된 PCAP은 삭제하지 않습니다."/></StackPanel><TextBlock DockPanel.Dock="Top" x:Name="BindingTitle" Text="NIC을 선택하세요" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/><TextBlock DockPanel.Dock="Top" Text="Ctrl/Shift로 여러 프로파일 선택" Foreground="#65748B" FontSize="{DynamicResource UiFont11}" Margin="0,0,0,12"/><ListBox x:Name="BindingProfiles" SelectionMode="Multiple" DisplayMemberPath="Name" BorderThickness="0"/></DockPanel></Border></Grid><Border Grid.Row="2" Background="White" CornerRadius="7" Padding="18" Margin="0,16,0,0"><StackPanel><TextBlock Text="기록 폴더 · 시험 시작 시 별도 하위 폴더 생성" FontWeight="SemiBold"/><DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="찾아보기" Click="ChooseFolderClick" Margin="12,0,0,0" ToolTip="기록 폴더를 선택해 경로 입력란에 넣습니다. 경로 저장을 눌러 적용하세요."/><Button DockPanel.Dock="Right" Content="경로 저장" Click="SaveFolderClick" Margin="12,0,0,0" ToolTip="입력한 절대 경로를 검증하고 다음 시험부터 사용할 저장 폴더로 적용합니다."/><TextBox x:Name="FolderBox"/></DockPanel><Button Content="이전 시험 메타데이터의 ICD 암호화" Click="ProtectLegacyClick" Margin="0,12,0,0" HorizontalAlignment="Left" ToolTip="이전 시험 메타데이터에 평문 ICD가 있으면 관리자 키로 암호화합니다. PCAP 파일은 그대로 둡니다."/></StackPanel></Border></Grid>
</Grid><TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#60728E" FontSize="{DynamicResource UiFont11}" TextWrapping="Wrap" VerticalAlignment="Center"/>
</Grid></Grid><Button x:Name="ScreenSettingsButton" Content="⚙ 설정" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,28,0" Click="ScreenSettingsClick" ToolTip="글자 크기·입력란 배치와 관리자 계정 보안을 탭별로 설정합니다."/></Grid></Window>
