on Content="선택 NIC 매칭 해제" Click="RemoveBindingClick" Margin="0"/></StackPanel><TextBlock DockPanel.Dock="Top" x:Name="BindingTitle" Text="NIC을 선택하세요" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/><TextBlock DockPanel.Dock="Top" Text="Ctrl/Shift로 여러 프로파일 선택" Foreground="#65748B" FontSize="{DynamicResource UiFont11}" Margin="0,0,0,12"/><ListBox x:Name="BindingProfiles" SelectionMode="Multiple" DisplayMemberPath="Name" BorderThickness="0"/></DockPanel></Border></Grid><Border Grid.Row="2" Background="White" CornerRadius="7" Padding="18" Margin="0,16,0,0"><StackPanel><TextBlock Text="기록 폴더 · 시험 시작 시 별도 하위 폴더 생성" FontWeight="SemiBold"/><DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="찾아보기" Click="ChooseFolderClick" Margin="12,0,0,0"/><Button DockPanel.Dock="Right" Content="경로 저장" Click="SaveFolderClick" Margin="12,0,0,0"/><TextBox x:Name="FolderBox"/></DockPanel><Button Content="이전 시험 메타데이터의 ICD 암호화" Click="ProtectLegacyClick" Margin="0,12,0,0" HorizontalAlignment="Left"/></StackPanel></Border></Grid>
